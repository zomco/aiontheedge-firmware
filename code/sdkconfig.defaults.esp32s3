##################################################
# ESP32-S3 specific configuration (ESP32-S3-CAM boards)
#
# ESP-IDF applies this file automatically on top of sdkconfig.defaults
# as soon as the target is esp32s3, see tools/cmake/kconfig.cmake.
# Everything set here therefore overrides the (ESP32 oriented) values
# of sdkconfig.defaults. Only settings which differ have to be listed.
#
# After editing make sure to explicitly delete
# sdkconfig.esp32s3cam to apply your changes!
##################################################

# Flash: the ESP32-S3-WROOM-1 modules used on the CAM boards have 8 MB or 16 MB.
# The partition table (partitions.csv) stays below 4 MB, so it fits on every variant.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_ESPTOOLPY_FLASHSIZE_DETECT=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM: the N8R8 / N16R8 modules (which the ESP32-S3-CAM boards use) have octal PSRAM.
# For a module with quad PSRAM (e.g. N8R2 / N16R2) replace CONFIG_SPIRAM_MODE_OCT
# by CONFIG_SPIRAM_MODE_QUAD=y.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# The camera driver of the ESP32-S3 (LCD_CAM peripheral) transfers the frames by GDMA
# into PSRAM, keep enough internal memory available for the DMA descriptors and WiFi.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=40960
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# HIMEM (bank switching) is an ESP32 only feature, the ESP32-S3 maps the full PSRAM
CONFIG_SPIRAM_BANKSWITCH_ENABLE=n

# ESP-NN provides dedicated SIMD optimized kernels for the ESP32-S3
CONFIG_NN_OPTIMIZED=y

# Console: the ESP32-S3-CAM boards expose UART0 (GPIO43/44) on their programming header.
# If your board only offers the native USB port of the ESP32-S3, use the built in
# USB Serial/JTAG controller instead:
#CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
